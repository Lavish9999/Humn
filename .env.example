# Vercel web project — public
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=

# Vercel web project — optional legacy public-key fallback
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Vercel web project — server only
# Preferred for current rotated Supabase sb_secret_ keys.
SUPABASE_SECRET_KEY=
# Optional legacy service-role JWT fallback.
SUPABASE_SERVICE_ROLE_KEY=
AUTH_RECOVERY_SECRET=

# Automated verification worker — server only
# Generate a long random value. Never expose this in NEXT_PUBLIC_* variables.
AUTOMATED_REVIEW_SECRET=
# Sightengine primary detector: required AI-generation + deepfake models only.
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
SIGHTENGINE_API_URL=https://api.sightengine.com/1.0/check.json
SIGHTENGINE_CORE_MODELS=genai,deepfake
# Recapture is not provisioned, not requested and not required for VERIFIED.
# Keep false. The dormant optional adapter can be re-enabled later only after paid access.
SIGHTENGINE_RECAPTURE_ENABLED=false
# Auxiliary safety models run separately so their failure cannot erase the AI score.
SIGHTENGINE_SAFETY_MODELS=nudity-2.1,violence,gore-2.0
# Hive V3 Playground independent secondary detector
HIVE_V3_SECRET_KEY=
HIVE_API_URL=https://api.thehive.ai/api/v3/hive/ai-generated-and-deepfake-content-detection
HIVE_MODEL_NAME=hive/ai-generated-and-deepfake-content-detection
# Optional legacy variable name accepted temporarily by the adapter
HIVE_API_KEY=
# Optional localized/partial-AI detector. Enable it in verification_pipeline_config only after provisioning.
ILLUMINARTY_API_URL=
ILLUMINARTY_API_KEY=
ILLUMINARTY_MEDIA_FIELD=media
ILLUMINARTY_AUTH_SCHEME=Bearer

# Expo mobile app — not used by the Vercel web deployment
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Local database maintenance only — not used by Vercel runtime
DATABASE_URL=

# Supabase Edge Functions receive these from Supabase automatically
SUPABASE_URL=
SUPABASE_ANON_KEY=
