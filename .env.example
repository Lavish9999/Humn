# Vercel web project — public
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=

# Vercel web project — optional legacy public-key fallback
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Vercel web project — server only
# Preferred for current rotated Supabase sb_secret_ keys.
SUPABASE_SECRET_KEY=
# Optional legacy service-role JWT fallback.
SUPABASE_SERVICE_ROLE_KEY=
AUTH_RECOVERY_SECRET=

# Automated verification worker — server only
# Generate a long random value. Never expose this in NEXT_PUBLIC_* variables.
AUTOMATED_REVIEW_SECRET=
# Sightengine primary detector
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
# Optional endpoint/model overrides
SIGHTENGINE_API_URL=https://api.sightengine.com/1.0/check.json
SIGHTENGINE_MODELS=genai,recapture,deepfake,nudity-2.1,violence,gore-2.0
# Hive independent secondary detector
HIVE_API_KEY=
HIVE_API_URL=https://api.thehive.ai/api/v2/task/sync
# Optional localized/partial-AI detector. Enable it in verification_pipeline_config only after provisioning.
ILLUMINARTY_API_URL=
ILLUMINARTY_API_KEY=
ILLUMINARTY_MEDIA_FIELD=media
ILLUMINARTY_AUTH_SCHEME=Bearer

# Expo mobile app — not used by the Vercel web deployment
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Local database maintenance only — not used by Vercel runtime
DATABASE_URL=

# Supabase Edge Functions receive these from Supabase automatically
SUPABASE_URL=
SUPABASE_ANON_KEY=
